<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Batch Job Monitor User</label>
    <description>Grants read access to the ApexPulse batch monitor objects and dashboard controller.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <tabSettings>
        <tab>Recent_Batch_Job_Logs</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <classAccesses>
        <apexClass>BatchJobController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BatchJobRollupHelper</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BatchJobTrackerScheduled</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BatchJobLogPurgeScheduled</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AlertService</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <objectPermissions>
        <object>Batch_Job_Log__c</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Daily_Job_Summary__c</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Status event: Read grants empApi subscribe rights. Publish is done by
         Apex in system context (§10), so Create is not granted to dashboard users. -->
    <objectPermissions>
        <object>Batch_Job_Update__e</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
    </objectPermissions>

    <fieldPermissions>
        <field>Batch_Job_Log__c.Async_Job_Id__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Job_Class_Name__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Job_Type__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Start_Time__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.End_Time__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Duration_Seconds__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Items_Processed__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Total_Items__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Items_Remaining__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Error_Count__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Failure_Reason__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Log__c.Date_Bucket__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <!-- Dedup marker. Written only by AlertService in system context, so it is
         readable (for reporting) but never editable by dashboard users. -->
    <fieldPermissions>
        <field>Batch_Job_Log__c.Failure_Alert_Sent__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <fieldPermissions>
        <field>Daily_Job_Summary__c.Summary_Key__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Daily_Job_Summary__c.Job_Class_Name__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Daily_Job_Summary__c.Summary_Date__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Daily_Job_Summary__c.Run_Count__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Daily_Job_Summary__c.Success_Count__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Daily_Job_Summary__c.Failure_Count__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Daily_Job_Summary__c.In_Progress_Count__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Daily_Job_Summary__c.Total_Jobs_Day__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Daily_Job_Summary__c.Avg_Duration_Seconds__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Daily_Job_Summary__c.Last_Updated__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <fieldPermissions>
        <field>Batch_Job_Update__e.Total_Jobs__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Batch_Job_Update__e.Publish_Time__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

</PermissionSet>
